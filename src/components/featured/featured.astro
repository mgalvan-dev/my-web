---
import type { Dictionary } from "../../models/dictionary.model";
import MarfenCase from "../marfen-case/marfen-case.astro";
import ProductCard from "../product-card/product-card.astro";
import styles from "./featured.module.css";

interface Props {
    dictionary: Dictionary["selectedWork"];
    marfenCase?: Dictionary["marfenCase"];
}

const { dictionary, marfenCase } = Astro.props;
const [marfen, ...secondaryWork] = dictionary.items;
---

<section id="work" class={styles.main_container} aria-labelledby="work-title">
    <div class={styles.heading}>
        <p class={styles.kicker}>03</p>
        <h2 id="work-title" class={styles.title}>{dictionary.title}</h2>
    </div>

    {
        marfen && marfenCase && (
            <MarfenCase item={marfen} content={marfenCase} />
        )
    }

    <div class={styles.secondary_work}>
        {
            secondaryWork.map((item) => (
                <ProductCard
                    dictionary={item}
                    contextLabel={dictionary.labels.contexts[item.context]}
                    statusLabel={
                        item.status
                            ? dictionary.labels.statuses[item.status]
                            : undefined
                    }
                />
            ))
        }
    </div>
</section>
