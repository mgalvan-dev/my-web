---
import type { SelectedWorkItem } from "../../models/dictionary.model";
import styles from "./product-card.module.css";

interface Props {
    dictionary: SelectedWorkItem;
    contextLabel: string;
    statusLabel?: string;
}

const { dictionary, contextLabel, statusLabel } = Astro.props;
---

<article class:list={[styles.card, dictionary.url && styles.linked]}>
    {dictionary.url ? (
        <a
            href={dictionary.url}
            target="_blank"
            rel="noopener noreferrer"
            class={styles.card_content}
        >
            {
                dictionary.image && (
                    <div class={styles.media}>
                        <img
                            src={dictionary.image}
                            alt={dictionary.imageAlt ?? dictionary.name}
                            loading="lazy"
                        />
                    </div>
                )
            }
            <div class={styles.header}>
                <p class={styles.context}>
                    {contextLabel}{statusLabel ? ` · ${statusLabel}` : ""}
                </p>
                <span class={styles.category}>{dictionary.category}</span>
                <h3 class={styles.name}>{dictionary.name}</h3>
            </div>
            <p class={styles.title}>{dictionary.title}</p>
            <p class={styles.description}>{dictionary.description}</p>
            <p class={styles.role}>{dictionary.role}</p>
            {
                dictionary.tags.length > 0 && (
                    <div class={styles.tags}>
                        {dictionary.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                )
            }
            {
                dictionary.linkLabel && (
                    <span class={styles.link_label}>{dictionary.linkLabel}</span>
                )
            }
        </a>
    ) : (
        <div class={styles.card_content}>
            {
                dictionary.image && (
                    <div class={styles.media}>
                        <img
                            src={dictionary.image}
                            alt={dictionary.imageAlt ?? dictionary.name}
                            loading="lazy"
                        />
                    </div>
                )
            }
            <div class={styles.header}>
                <p class={styles.context}>
                    {contextLabel}{statusLabel ? ` · ${statusLabel}` : ""}
                </p>
                <span class={styles.category}>{dictionary.category}</span>
                <h3 class={styles.name}>{dictionary.name}</h3>
            </div>
            <p class={styles.title}>{dictionary.title}</p>
            <p class={styles.description}>{dictionary.description}</p>
            <p class={styles.role}>{dictionary.role}</p>
            {
                dictionary.tags.length > 0 && (
                    <div class={styles.tags}>
                        {dictionary.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                )
            }
        </div>
    )}
</article>
