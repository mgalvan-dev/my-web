---
import type { Dictionary } from "../../models/dictionary.model";
import styles from "./hero.module.css";

interface Props {
    dictionary: Dictionary["hero"];
}

const { dictionary } = Astro.props;
---

<section class={styles.main_container} aria-labelledby="hero-title">
    <article class={styles.content_container}>
        <p class={styles.eyebrow}>{dictionary.eyebrow}</p>
        <h1 id="hero-title" class={styles.title}>{dictionary.title}</h1>
        <p class={styles.description}>{dictionary.description}</p>

        <div class={styles.button_group}>
            <a class={styles.primary_button} href="#contact-form" data-analytics-event="contact_cta_clicked">
                {dictionary.primaryCta}
            </a>
            <a class={styles.secondary_button} href="#work">
                {dictionary.secondaryCta}
            </a>
        </div>
        <p class={styles.proof}>{dictionary.proof}</p>
    </article>
</section>
