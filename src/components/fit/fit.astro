---
import type { Dictionary } from "../../models/dictionary.model";
import styles from "./fit.module.css";

interface Props {
    dictionary: Dictionary["fit"];
}

const { dictionary } = Astro.props;
---

<section id="fit" class={styles.section} aria-labelledby="fit-title">
    <div class={styles.heading}>
        <p class={styles.kicker}>06</p>
        <h2 id="fit-title" class={styles.title}>{dictionary.title}</h2>
    </div>

    <ul class={styles.list}>
        {dictionary.items.map((item) => <li>{item}</li>)}
    </ul>

    <p class={styles.note}>{dictionary.note}</p>
</section>
