---
import type { Dictionary } from "../../models/dictionary.model";
import styles from "./problem.module.css";

interface Props {
    dictionary: Dictionary["problem"];
}

const { dictionary } = Astro.props;
---

<section class={styles.section} aria-labelledby="problem-title">
    <div class={styles.heading}>
        <p class={styles.kicker}>01</p>
        <h2 id="problem-title" class={styles.title}>{dictionary.title}</h2>
        <p class={styles.body}>{dictionary.body}</p>
    </div>

    <ul class={styles.list}>
        {dictionary.items.map((item) => <li>{item}</li>)}
    </ul>

    <p class={styles.closing}>{dictionary.closing}</p>
</section>
