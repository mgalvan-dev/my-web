---
import type { ProfessionalCaseContent } from "../../models/dictionary.model";
import styles from "./professional-case.module.css";

interface Props {
    dictionary: ProfessionalCaseContent;
    locale: "en" | "es";
}

const { dictionary, locale } = Astro.props;
const narrativeCopy = {
    en: {
        problem: "Problem",
        decision: "Decision and redesign",
        solution: "Solution",
        result: "Result",
    },
    es: {
        problem: "Problema",
        decision: "Decisión y rediseño",
        solution: "Solución",
        result: "Resultado",
    },
}[locale];

const narrativeBlocks = [
    { label: narrativeCopy.problem, copy: dictionary.problem },
    { label: narrativeCopy.decision, copy: dictionary.decision },
    { label: narrativeCopy.solution, copy: dictionary.solution },
    { label: narrativeCopy.result, copy: dictionary.result },
];
---

<section class={styles.section} aria-labelledby="professional-case-title">
    <article class={styles.case}>
        <p class={styles.eyebrow}>{dictionary.eyebrow}</p>
        <h2 id="professional-case-title" class={styles.title}>{dictionary.title}</h2>

        <div class={styles.narrative}>
            {
                narrativeBlocks.map(({ label, copy }) => (
                    <div class={styles.narrative_item}>
                        <h3>{label}</h3>
                        <p>{copy}</p>
                    </div>
                ))
            }
        </div>

        <a class={styles.cta} href="#contact-form" data-analytics-event="case_clicked">
            {dictionary.cta}
        </a>
    </article>
</section>
