---
import type { Dictionary } from "../../models/dictionary.model";
import styles from "./navbar.module.css";

interface Props {
    lang: "en" | "es";
    dictionary: Dictionary["navigation"];
}

const { lang, dictionary } = Astro.props;
const languageHref = lang === "en" ? "/es/" : "/";
const languageCode = lang === "en" ? "ES" : "EN";
const language = lang === "en" ? "es" : "en";
---

<nav class={styles.main_container} aria-label={dictionary.menuLabel}>
    <details class={styles.menu} data-navigation-menu open>
        <summary class={styles.menu_toggle}>{dictionary.menuLabel}</summary>
        <div class={styles.links_container}>
            <a class={styles.link} href="#services">{dictionary.services}</a>
            <a class={styles.link} href="#work">{dictionary.work}</a>
            <a class={styles.link} href="#about">{dictionary.about}</a>
            <a class={styles.link} href="#contact">{dictionary.contact}</a>
            <a
                class={styles.language_link}
                href={languageHref}
                hreflang={language}
                data-analytics-event="language_changed"
                aria-label={dictionary.languageLabel}
            >
                {languageCode}
            </a>
            <a class={styles.cta_link} href="#contact" data-analytics-event="contact_cta_clicked">{dictionary.cta}</a>
        </div>
    </details>
</nav>

<script is:inline>
    const menu = document.querySelector("[data-navigation-menu]");
    const mobileViewport = window.matchMedia("(width <= 880px)");

    if (menu instanceof HTMLDetailsElement) {
        const syncMenuState = () => {
            menu.open = !mobileViewport.matches;
        };

        syncMenuState();
        mobileViewport.addEventListener("change", syncMenuState);
    }
</script>
