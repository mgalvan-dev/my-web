---
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-sans/700.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import AnalyticsEvents from "../components/analytics/analytics-events.astro";
import { CONTACT_EMAIL_ADDRESS, SITE_URL, SOCIAL_LINKS } from "../consts";

interface AlternateLanguage {
    lang: string;
    href: string;
}

interface SiteMetadata {
    title: string;
    description: string;
    ogImageAlt: string;
}

interface Props {
    lang: "en" | "es";
    metadata: SiteMetadata;
    role: string;
    canonicalPath?: string;
    ogImage?: string;
    ogType?: "website" | "profile";
    alternates?: AlternateLanguage[];
    noindex?: boolean;
}

const {
    lang,
    metadata,
    role,
    canonicalPath = Astro.url.pathname,
    ogImage = SITE_URL + "/og-image.png",
    ogType = "profile",
    alternates = [],
    noindex = false,
}: Props = Astro.props;

const { title, description, ogImageAlt } = metadata;

const canonicalURL = new URL(canonicalPath, SITE_URL).href;
const ogImageURL = new URL(ogImage, SITE_URL).href;
const alternateLanguages = alternates.filter(
    (alternate) => alternate.lang !== lang && ["en", "es"].includes(alternate.lang),
);

const defaultAlternate = alternates.find(
    (alternate) => alternate.lang === "x-default",
);

const personId = `${SITE_URL}/#person`;
const profilePageId = `${canonicalURL}#profile-page`;

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": profilePageId,
    url: canonicalURL,
    name: title,
    headline: "Marco Galván — " + role,
    description,
    inLanguage: lang,
    isPartOf: {
        "@type": "WebSite",
        "@id": `${SITE_URL}/#website`,
        url: SITE_URL,
        name: "Marco Galván",
    },
    mainEntity: {
        "@type": "Person",
        "@id": personId,
        name: "Marco Galván",
        url: SITE_URL,
        image: {
            "@type": "ImageObject",
            url: ogImageURL,
        },
        email: CONTACT_EMAIL_ADDRESS,
        jobTitle: role,
        homeLocation: {
            "@type": "Place",
            name: "Santiago del Estero, Argentina",
        },
        knowsLanguage: ["es", "en"],
        worksFor: {
            "@type": "Organization",
            name: "Dam Squad",
        },
        knowsAbout: [
            "Product Development",
            "Digital Products",
            "Web and Mobile Software",
            "SaaS",
            "Business Process Automation",
            "Systems Integration",
            "Applied Artificial Intelligence",
        ],
        sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github, SOCIAL_LINKS.x],
        mainEntityOfPage: {
            "@id": profilePageId,
        },
    },
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>

        <meta name="description" content={description} />
        <meta name="author" content="Marco Galván" />
        <meta
            name="robots"
            content={noindex
                ? "noindex, follow"
                : "index, follow, max-image-preview:large"}
        />
        <meta name="theme-color" content="#0a0a0a" />

        <link rel="canonical" href={canonicalURL} />

        {
            alternates.map(({ lang: alternateLang, href }) => (
                <link
                    rel="alternate"
                    hreflang={alternateLang}
                    href={new URL(href, SITE_URL).href}
                />
            ))
        }

        {
            !defaultAlternate && alternates.length > 0 && (
                <link
                    rel="alternate"
                    hreflang="x-default"
                    href={canonicalURL}
                />
            )
        }

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="Marco Galván" />
        <meta
            property="og:locale"
            content={lang === "en" ? "en_US" : "es_AR"}
        />
        <meta property="og:image" content={ogImageURL} />
        <meta
            property="og:image:alt"
            content={ogImageAlt}
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        {
            alternateLanguages.map(({ lang: alternateLang }) => (
                    <meta
                        property="og:locale:alternate"
                        content={alternateLang === "en" ? "en_US" : "es_AR"}
                    />
                ))
        }

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
        <meta
            name="twitter:image:alt"
            content={ogImageAlt}
        />
        <meta name="twitter:site" content="@MarcoGal4" />
        <meta name="twitter:creator" content="@MarcoGal4" />

        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />

        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(structuredData)}
        />

        <Analytics />
        <SpeedInsights />
        <AnalyticsEvents />
    </head>

    <body>
        <slot />
    </body>
</html>

<style is:global>
    :root {
        background-color: #0a0a0a;
        color: #fafafa;
        color-scheme: dark;
        font-family: "Geist Sans", sans-serif;
        --site-bg: #0a0a0a;
        --site-surface: #111111;
        --site-surface-raised: #171717;
        --site-text: #fafafa;
        --site-text-muted: #a3a3a3;
        --site-border: #262626;
        --site-border-strong: #404040;
        --site-accent: #4ade80;
        --site-container: 1120px;
        --site-radius-sm: 0.65rem;
        --site-radius-md: 1rem;
        --site-radius-lg: 1.5rem;
        --site-space-1: 0.5rem;
        --site-space-2: 0.75rem;
        --site-space-3: 1rem;
        --site-space-4: 1.5rem;
        --site-space-5: 2rem;
        --site-space-6: 3rem;
        --site-space-7: 5rem;
    }

    *,
    *::after,
    *::before {
        min-width: 0;
        box-sizing: border-box;
        padding: 0;
        margin: 0;
    }

    img,
    video,
    svg {
        display: block;
        height: auto;
        max-width: 100%;
    }

    html {
        scroll-padding-top: 80px;
    }

    html,
    body {
        min-height: 100dvh;
        scroll-behavior: smooth;
    }

    body {
        color: var(--site-text);
        background: var(--site-bg);
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        text-wrap: balance;
    }

    p {
        text-wrap: pretty;
    }

    a,
    button,
    summary {
        -webkit-tap-highlight-color: transparent;
    }

    .skip-link {
        position: absolute;
        left: 8px;
        top: -48px;
        z-index: 100;
        padding: 8px 16px;
        background-color: #fafafa;
        color: #111;
        border-radius: 8px;
        text-decoration: none;
        transition: top 0.15s ease-in-out;
    }

    .skip-link:focus {
        top: 8px;
    }

    :focus-visible {
        outline: 2px solid var(--site-accent);
        outline-offset: 3px;
        border-radius: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }

        html {
            scroll-behavior: auto;
        }
    }
</style>
